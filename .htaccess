# Extensionless URLs: /privacy -> privacy.html, /about -> about.html, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # If the request is not for a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # And adding .html gives a file that exists
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Newsroom: /newsroom/write is the editor, any other /newsroom/<slug> is a story
  RewriteRule ^newsroom/?$ newsroom.html [L]
  RewriteRule ^newsroom/write/?$ newsroom-write.html [L]
  RewriteRule ^newsroom/([^/]+)/?$ newsroom-article.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Cache images for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
